<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- Plans are picked up as ordinary bills, but still under the Managing work type so the
         colony's designated managers are the ones who do them. -->
    <WorkGiverDef>
        <defName>WMC_EnactManagementPlans</defName>
        <label>enact management plans</label>
        <giverClass>WorkGiver_DoBill</giverClass>
        <workType>Managing</workType>
        <priorityInType>100</priorityInType>
        <verb>manage</verb>
        <gerund>managing</gerund>
        <scanThings>true</scanThings>
        <scanCells>false</scanCells>
        <fixedBillGiverDefs>
            <li>CM_ManagerStation</li>
            <li>CM_BasicManagerStation</li>
            <li>CMR_ManagingSpot</li>
        </fixedBillGiverDefs>
        <requiredCapacities>
            <li>Manipulation</li>
        </requiredCapacities>
        <prioritizeSustains>true</prioritizeSustains>
    </WorkGiverDef>
</Defs>
